#!/bin/sh
# Pre-commit hook for Java projects

echo "Running pre-commit checks..."

# Run Maven compile to check for compilation errors
echo "Checking compilation..."
mvn compile -q
if [ $? -ne 0 ]; then
    echo "Compilation failed. Please fix compilation errors before committing."
    exit 1
fi

# Run tests
echo "Running tests..."
mvn test -q
if [ $? -ne 0 ]; then
    echo "Tests failed. Please fix failing tests before committing."
    exit 1
fi

# Run Checkstyle
echo "Running Checkstyle..."
mvn checkstyle:check -q
if [ $? -ne 0 ]; then
    echo "Checkstyle violations found. Please fix code style issues before committing."
    exit 1
fi

echo "All checks passed!"
exit 0